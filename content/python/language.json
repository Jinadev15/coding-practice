{
  "name": "Python",
  "order": 1,
  "color": "#3776ab",
  "icon": "Py",
  "ext": "py",
  "main": "main.py",
  "editor_mode": "python",
  "compile": null,
  "run": [
    "{python}",
    "-E",
    "-s",
    "-X",
    "utf8",
    "main.py"
  ],
  "time_limit": 2,
  "memory_mb": 2048,
  "env": {
    "OMP_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1",
    "MPLBACKEND": "Agg",
    "MPLCONFIGDIR": ".mpl",
    "TORCH_NUM_THREADS": "1"
  }
}
